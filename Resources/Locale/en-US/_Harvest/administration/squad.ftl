cmd-squadmode-desc = Toggles the NPC squad tool: select mobs and give them RTS-style orders.
cmd-squadmode-help = Usage: squadmode
cmd-squadmode-on = Squad tool on.
cmd-squadmode-off = Squad tool off.

cmd-squadorder-desc = Gives an order to NPCs: move, attackmove, hold, release or attack.
cmd-squadorder-help = Usage: squadorder <move|attackmove> <x> <y> <uid...>, squadorder attack <target> <uid...> or squadorder <hold|release> <uid...>
cmd-squadorder-invalid-args = Usage: squadorder <move|attackmove> <x> <y> <uid...>, squadorder attack <target> <uid...> or squadorder <hold|release> <uid...>
cmd-squadorder-hint = <x> <y> <uid...> for move/attackmove, <uid...> for hold/release, <target> <uid...> for attack
cmd-squadorder-result = {$count} of {$total} NPCs took the order.
